# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# ── Auth (NextAuth v5) ──────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=

# ── App URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bootstrap admin (used only by prisma/seed.ts) ───────────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Database (Supabase PostgreSQL) ──────────────────────────────────
# On newer Supabase projects the direct hostname (db.<ref>.supabase.co)
# is IPv6-only. If your environment has no outbound IPv6 route, use the
# regional pooler host for both instead:
#   DATABASE_URL -> port 6543, transaction mode, ?pgbouncer=true
#   DIRECT_URL   -> port 5432, session mode (required by Prisma Migrate,
#                   since pgbouncer's transaction mode doesn't support
#                   prepared statements)
DATABASE_URL=
DIRECT_URL=

# ── File storage (Cloudflare R2, S3-compatible) ─────────────────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=auto

# ── AI review (Groq) ─────────────────────────────────────────────────
GROQ_API_KEY=

# ── Google Docs Bridge (Apps Script) ────────────────────────────────
# Mode "mock" (default if unset) returns a sample document with no
# network call — safe for local dev without a live Apps Script deployment.
# Mode "apps-script" calls the deployed Apps Script web app below.
# Set to "apps-script" in production.
GOOGLE_DOC_BRIDGE_MODE=mock
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_SHARED_SECRET=
